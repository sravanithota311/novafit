# Copy this file to `.env` and edit only what you want to override.
# Every value has a sensible default in rag/config.py, so .env is optional.

# --- Model ---
# Agent mode needs a tool-calling model. Recommended:
#   ollama pull qwen2.5:3b
# LLM_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
# KEEP_ALIVE=10m

# --- Web search ---
# MAX_WEB_RESULTS=5

# --- Retrieval tuning ---
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=4
# TEMPERATURE=0

# --- Branding ---
# ASSISTANT_NAME=Nova
# KNOWLEDGE_BASE_TOPIC=an organization's HR policies, benefits, leave, and code of conduct
